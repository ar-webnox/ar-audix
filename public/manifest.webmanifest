{
  "id": "./",
  "name": "AR AUDIX",
  "short_name": "AR AUDIX",
  "description": "A premium local music player. Your music stays on your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0b0e",
